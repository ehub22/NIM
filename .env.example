# ---------------------------------------------------------------------------
# NIM Chat - environment variables
#
# Copy this file to `.env.local` and adjust as needed. Every value here is
# OPTIONAL; the application works with the built-in defaults.
#
# SECURITY: variables prefixed with VITE_ are inlined into the browser bundle
# by Vite at build time. They are therefore PUBLIC. Never put an NVIDIA NIM
# API key (or any other secret) in one of these files. The API key is entered
# by each user at runtime and kept only in their own browser storage.
# ---------------------------------------------------------------------------

# Base URL of the OpenAI-compatible endpoint the client talks to.
#
# Default (production build):  https://integrate.api.nvidia.com/v1
# Default (vite dev server):   /nim-api/v1   (proxied, avoids CORS)
#
# Point this at your own proxy when you deploy to GitHub Pages, e.g.
#   VITE_NIM_BASE_URL=https://nim-proxy.example.com/v1
VITE_NIM_BASE_URL=

# Request timeout in milliseconds for non-streaming calls (default: 60000).
VITE_NIM_TIMEOUT_MS=

# Milliseconds to wait for the next streaming chunk before giving up
# (default: 120000).
VITE_NIM_STREAM_IDLE_TIMEOUT_MS=

# Optional label shown in the settings dialog next to the endpoint field,
# useful when pointing the app at a self-hosted NIM or a proxy.
VITE_NIM_ENDPOINT_LABEL=
